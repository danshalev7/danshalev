---
interface Props {
  class?: string;
  size?: number;
}

const { class: className, size = 100 } = Astro.props;
---

<div
  class:list={["flex items-center justify-center", className]}
  style={`width: ${size}px; height: ${size}px;`}
>
  <svg
    class="h-full w-full"
    viewBox="0 0 100 100"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <linearGradient id="astroBridgeGrad" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#0066FF"></stop>
        <stop offset="100%" stop-color="#00F2B6"></stop>
      </linearGradient>
    </defs>
    <path d="M15,25 L50,50 L15,75 Z" fill="url(#astroBridgeGrad)"></path>
    <path d="M48,25 L83,50 L48,75 Z" fill="#00F2B6"></path>
  </svg>
</div>
