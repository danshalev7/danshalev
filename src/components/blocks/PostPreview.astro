---
import { formatDate } from "@/utils/date";
import { Icon } from "astro-icon/components";
import type { CollectionEntry } from "astro:content";
import { getEntry } from "astro:content";
import site from "@/config/site";

interface Props {
  post: CollectionEntry<"posts">;
}

const { post } = Astro.props;
const category = await getEntry(
  post.data.category.collection,
  post.data.category.id,
);

// Auto-detect if post is new based on creation date
// Draft posts should not show "new" badge
const isNew =
  !post.data.draft &&
  (post.data.new ||
    (site.features.newPostDays > 0 &&
      (Date.now() - new Date(post.data.createdAt).getTime()) /
        (1000 * 60 * 60 * 24) <=
        site.features.newPostDays));
---

<article
  class="group flex cursor-pointer items-center justify-between border-b border-white/5 py-6 last:border-0"
>
  <div>
    <a
      href={`/writing/${post.id}`}
      class="inline-flex items-center gap-2 text-lg font-semibold text-on-surface/80 transition-colors duration-100 ease-snap group-hover:text-flat-cobalt"
    >
      <span>{post.data.title}</span>
      {
        isNew && (
          <span class="rounded bg-flat-cobalt/10 px-1.5 py-0.5 text-[10px] font-bold tracking-wider text-flat-cobalt uppercase">
            New
          </span>
        )
      }
      {
        post.data.draft && (
          <span class="rounded bg-surface-lowest px-1.5 py-0.5 text-[10px] font-bold tracking-wider text-on-surface-muted uppercase">
            Draft
          </span>
        )
      }
    </a>
    <p
      class="mt-2 font-mono text-[11px] text-on-surface-muted italic opacity-60"
    >
      {formatDate(post.data.createdAt)} —
      <a href={`/categories/${category?.id}`} class="hover:text-flat-cobalt">
        {category?.data.name}
      </a>
    </p>
  </div>
  <span
    class="text-white/20 transition-all duration-100 ease-snap group-hover:translate-x-1 group-hover:text-flat-cobalt"
  >
    <Icon name="mdi:arrow-right" />
  </span>
</article>
