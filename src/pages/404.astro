---
import Layout from "../layouts/Layout.astro";
import site from "@/config/site";
---

<Layout title="404" description="not found">
  <div
    class="animate-in fade-in zoom-in flex h-full flex-col items-center justify-center p-8 text-center duration-700 md:p-16"
  >
    <div class="relative mb-8">
      <h2
        class="text-[8rem] leading-none font-black text-flat-cobalt/5 select-none md:text-[12rem]"
      >
        404
      </h2>
      <div class="absolute inset-0 flex items-center justify-center">
        <span
          class="text-2xl font-black tracking-tighter text-on-surface/80 uppercase md:text-3xl"
        >
          {site.labels.notFoundTitle}
        </span>
      </div>
    </div>

    <div class="mx-auto max-w-xs space-y-6">
      <p class="text-base leading-relaxed font-light text-on-surface-muted">
        {site.labels.notFoundDescription}
      </p>

      <div class="pt-4">
        <a
          href="/"
          class="inline-flex items-center gap-2 rounded-2xl bg-flat-cobalt px-6 py-3 text-sm font-bold text-on-surface transition-all duration-100 ease-snap [clip-path:polygon(0_0,_90%_0,_100%_35%,_100%_100%,_0_100%)] hover:bg-flat-cyan hover:text-surface"
        >
          {site.labels.goHome}
        </a>
      </div>
    </div>

    <p
      class="mt-20 font-mono text-[10px] tracking-[0.4em] text-on-surface-muted/30 uppercase"
    >
      Error Code: Page_Not_Found
    </p>
  </div>
</Layout>
