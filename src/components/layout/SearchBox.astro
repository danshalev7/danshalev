---
import { Icon } from "astro-icon/components";
---

<div class="mb-4">
  <button
    id="search-trigger"
    class="group flex w-full items-center justify-between rounded-xl bg-surface-lowest px-3 py-3 text-on-surface-muted transition-colors duration-100 ease-snap hover:text-flat-cobalt"
    title="search trigger"
  >
    <div class="flex items-center gap-2">
      <Icon name="mdi:search" />
      <span class="text-xs font-medium">Search</span>
    </div>
    <kbd
      class="hidden items-center gap-1 rounded bg-surface-low px-1.5 py-0.5 font-sans text-[12px] opacity-50 md:flex"
    >
      <Icon name="mdi:apple-keyboard-command" size={12} /> K
    </kbd>
  </button>
</div>
