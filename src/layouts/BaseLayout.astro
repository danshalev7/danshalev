---
import Head from "@/components/layout/Head.astro";
import type { HeadProps } from "@/types";
import "@/styles/global.css";
import Umami from "@/components/analytics/Umami.astro";
import site from "@/config/site";

type Props = HeadProps;

const head = Astro.props;
---

<html lang={site.meta.lang} class="dark">
  <Head {...head} />
  <body
    class="flex min-h-screen items-center justify-center bg-surface p-2 font-sans text-on-surface antialiased selection:bg-flat-cobalt/20 md:p-6"
  >
    <slot />

    <Umami />
  </body>
</html>
