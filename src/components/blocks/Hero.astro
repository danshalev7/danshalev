---
import { Icon } from "astro-icon/components";
import site from "@/config/site";
---

<section class="mb-16">
  <h2
    class="mb-6 text-3xl font-black tracking-tighter text-on-surface uppercase"
  >
    {site.hero.greeting}
  </h2>
  <p
    class="text-lg leading-relaxed font-light text-on-surface-muted"
    set:html={site.hero.description}
  />
</section>

{
  site.hero.cards.length > 0 && (
    <div class="mb-16 grid grid-cols-1 gap-4 md:grid-cols-2">
      {site.hero.cards.map((card, i) => (
        <div
          class="flex gap-4 rounded-2xl bg-surface-low p-5 transition-all duration-100 ease-snap hover:-translate-y-1"
          style={`animation-delay: ${i * 100}ms`}
        >
          <div class="text-lg text-flat-cobalt">
            <Icon name={card.icon} />
          </div>
          <div class="flex flex-col">
            <span class="text-[10px] font-bold tracking-[0.18em] text-on-surface-muted uppercase">
              {card.label}
            </span>
            <span class="text-sm text-on-surface/80">{card.value}</span>
          </div>
        </div>
      ))}
    </div>
  )
}
