---
import site from "@/config/site";
import { Image } from "astro:assets";
---

<div
  class="mb-6 flex items-center gap-4 md:mb-10 md:flex-col md:items-start md:gap-0"
>
  <div
    class="flex h-10 w-10 items-center justify-center rounded-full bg-surface-lowest text-lg font-bold md:h-11 md:w-11"
  >
    <Image
      loading={"eager"}
      src={site.meta.logo}
      alt={"Dan Shalev"}
      width={50}
      height={50}
      class="rounded-full object-cover"
    />
  </div>
  <div class="md:mt-8">
    <h1
      data-pagefind-ignore
      class="text-lg font-bold tracking-tight text-on-surface md:text-xl"
    >
      {site.meta.title}
    </h1>
    <p class="mt-2 hidden text-xs text-on-surface-muted/70 md:block">
      {site.meta.description}
    </p>
  </div>
</div>
