---
import PostPreview from "@/components/blocks/PostPreview.astro";
import { getRecentPosts } from "@/utils/post";
import { Icon } from "astro-icon/components";

const recentPosts = await getRecentPosts(5);
---

<section>
  <div class="mb-8 flex items-center justify-between">
    <p
      class="text-[11px] font-bold tracking-[0.18em] text-on-surface-muted uppercase opacity-60"
    >
      Latest
    </p>
    <a
      href="/writing"
      class="flex items-center gap-1 text-[11px] text-on-surface-muted transition-colors duration-100 ease-snap hover:text-flat-cobalt"
      >View all <Icon name="mdi:arrow-right" /></a
    >
  </div>

  <div class="space-y-1">
    {recentPosts.map((post) => <PostPreview post={post} />)}
  </div>
</section>
