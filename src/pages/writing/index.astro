---
import PostPreview from "@/components/blocks/PostPreview.astro";
import Layout from "@/layouts/Layout.astro";
import { getPosts } from "@/utils/post";
import site from "@/config/site";

const posts = await getPosts();
const years = [
  ...new Set(posts.map((post) => post.data.createdAt.getFullYear())),
];
---

<Layout
  title={site.labels.postsTitle}
  description={`${site.labels.postsDescription} — ${posts.length} posts.`}
>
  <div
    class="animate-in fade-in slide-in-from-bottom-4 mx-auto max-w-2xl p-8 duration-700 md:p-16"
  >
    <header class="mb-12">
      <h2
        class="mb-4 text-3xl font-black tracking-tighter text-on-surface uppercase"
      >
        {site.labels.postsTitle}
      </h2>
      <p class="text-sm font-light text-on-surface-muted italic">
        {site.labels.postsDescription} — {posts.length} posts.
      </p>
    </header>

    <div class="space-y-16">
      {
        years.map((year) => (
          <section class="relative">
            <h3 class="year text-4xl tracking-tighter text-on-surface/40">
              {year}
            </h3>
            <div class="space-y-8">
              {posts
                .filter((post) => post.data.createdAt.getFullYear() === year)
                .map((post) => (
                  <PostPreview post={post} />
                ))}
            </div>
          </section>
        ))
      }
    </div>
  </div>
</Layout>

<style>
  .year {
    -webkit-text-fill-color: transparent;
    -webkit-text-stroke: 1px rgba(255, 255, 255, 0.1);
  }
</style>
